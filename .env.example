# ==========================================
# AI Browser Agent - Environment Configuration
# ==========================================

# Google Gemini AI API Key (Get a free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Backend Database (Default: SQLite local file)
DATABASE_URL=sqlite:///./agent.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000

# Frontend Next.js Public URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Application Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=info
